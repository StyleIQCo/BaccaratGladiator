// ═══════════════════════════════════════════════════════════════════
//  BACCARAT GLADIATOR — SOCIAL LAYER SCHEMA
//  Durable social data lives here (Postgres). The HOT leaderboard path
//  stays in Redis ZSETs (`lb:{seasonKey}:{tier}`) — this schema stores
//  the durable mirror: season results, audit history, profile state.
//  Chips remain virtual social-casino currency; integrity rules are
//  still written as if they were real money (same stance as ledger.ts).
// ═══════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── USERS & GLOBE PROGRESSION ────────────────────────────────────────
// 62 stages across 10 tiers. `tier` is the bracket used for leaderboard
// matchmaking; `stageIndex` is the global pointer along the world tour.

model User {
  id         String   @id @default(cuid())
  handle     String   @unique // public display name, profanity-screened
  avatarKey  String   @default("gladiator-01")
  cognitoSub String?  @unique // bridge to the existing Cognito identity
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  // Evergreen personal invite code ("GLAD-7F3K" style), assigned at
  // registration. BuddyPass codes are the limited-use VIP tickets; this
  // one never expires and never runs out. Nullable so legacy rows can
  // backfill lazily on next login.
  referralCode String? @unique

  tier       Int    @default(1) // 1..10 — leaderboard bracket
  stageIndex Int    @default(0) // 0..61 — world-tour pointer
  chips      BigInt @default(1000) // canonical durable balance; Redis holds the hot mirror
  gems       Int    @default(50)
  xp         Int    @default(0)

  stageClears      StageClear[]
  scores           LeaderboardScore[]
  missionProgress  MissionProgress[]
  buddyPasses      BuddyPass[]
  referralsSent    Referral[]         @relation("Referrer")
  referralReceived Referral?          @relation("Referee")
  chipTxns         ChipTransaction[]

  @@index([tier])
}

// Passport stamps: one row per cleared stage. Powers the Digital
// Passport grid and "stages cleared" mission metrics.
model StageClear {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stageSlug String // 'macau', 'candy-rush', … (matches themes-extended.js slugs)
  tier      Int
  bestScore Int      @default(0)
  clearedAt DateTime @default(now())

  @@unique([userId, stageSlug]) // a stamp can't be earned twice
  @@index([userId, tier])
}

// ── REFERRALS: BUDDY PASSES ──────────────────────────────────────────
// A BuddyPass is the shareable artifact (the glowing ticket). A
// Referral is one redemption of a pass — created when the invitee
// signs up, QUALIFIED once they hit the anti-fraud bar (e.g. 20 hands
// played + tier 2), REWARDED once both sides claim.

model BuddyPass {
  id          String     @id @default(cuid())
  code        String     @unique // short share code, e.g. "GLAD-7F3K"
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  maxUses     Int        @default(5)
  uses        Int        @default(0) // denormalized count, bumped in the redeem txn
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())
  redemptions Referral[]
}

model Referral {
  id                    String         @id @default(cuid())
  passId                String? // set when redeemed via a BuddyPass ticket; null for User.referralCode signups
  pass                  BuddyPass?     @relation(fields: [passId], references: [id])
  codeUsed              String? // the literal code entered at signup — audit trail for fraud review
  referrerId            String
  referrer              User           @relation("Referrer", fields: [referrerId], references: [id])
  refereeId             String         @unique // one referral credit per new account, ever
  referee               User           @relation("Referee", fields: [refereeId], references: [id])
  status                ReferralStatus @default(PENDING)
  createdAt             DateTime       @default(now())
  qualifiedAt           DateTime? // set when the referee clears the anti-fraud bar
  referrerRewardClaimed Boolean        @default(false)
  refereeRewardClaimed  Boolean        @default(false)

  // Hongbao skin: the referral IS a red envelope. hongbaoValue is the
  // chips inside — 8s only, never a 4: the CHECK constraint added in
  // 20260825000000_hongbao_referrals rejects any amount containing the
  // digit 4 (tetraphobia). Opening is exactly-once via hongbaoOpenedAt
  // (same guarded-flip pattern as MissionProgress.claimedAt).
  hongbaoValue    Int       @default(8888)
  hongbaoOpenedAt DateTime? // referee tore it open; null = still sealed
  blessing        String?   @db.VarChar(120) // referrer's message, e.g. 恭喜发财

  @@index([referrerId, status])
}

enum ReferralStatus {
  PENDING // referee signed up, hasn't qualified yet
  QUALIFIED // qualification bar met — rewards claimable (buddy-pass claim flow)
  REWARDED // both sides claimed (buddy-pass claim flow)
  COMPLETED // referral-engine instant-payout path: welcome gift paid at signup, referrer bounty auto-paid on Stage-1 clear
  EXPIRED // referee inactive past the qualification window
}

// ── CURRENCY LEDGER ──────────────────────────────────────────────────
// Durable append-only record of every chip mutation the social/referral
// layer makes. The unique `idemKey` is the hard exactly-once guarantee:
// a replayed credit attempt hits the constraint and rolls back its whole
// transaction, so a reward can never pay twice — same stance as the
// Redis ledger's `done(idemKey)` set, but audit-grade and permanent.

model ChipTransaction {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       BigInt // signed: positive = credit, negative = debit
  balanceAfter BigInt // User.chips immediately after this row's write, same txn
  reason       ChipTxReason
  idemKey      String       @unique // e.g. "referral:{referralId}:bounty"
  meta         Json? // free-form context: { referralId, refereeId, ... }
  createdAt    DateTime     @default(now())

  @@index([userId, createdAt(sort: Desc)]) // "recent activity" statement query
}

enum ChipTxReason {
  REFERRAL_WELCOME_GIFT // referee's instant signup gift
  REFERRAL_BOUNTY // referrer's payout when the referee clears Stage 1
  MISSION_REWARD
  STAGE_REWARD
  GAME_SETTLEMENT // durable mirror of Redis settleRound credits
  ADMIN_ADJUST
}

// ── LEADERBOARDS (tier-bracketed, seasonal) ──────────────────────────
// Live ranks are answered by Redis (ZREVRANK on lb:{seasonKey}:{tier});
// every score mutation ALSO upserts here so seasons can be closed,
// audited, and replayed. The covering index makes "top N in my tier"
// a single index scan when Redis is cold.

model LeaderboardSeason {
  id       String             @id @default(cuid())
  key      String             @unique // '2026-08' — monthly seasons
  startsAt DateTime
  endsAt   DateTime
  scores   LeaderboardScore[]
}

model LeaderboardScore {
  id         String            @id @default(cuid())
  seasonId   String
  season     LeaderboardSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier       Int // bracket at time of scoring — a mid-season tier-up re-brackets forward, history stays
  score      BigInt            @default(0)
  bestStreak Int               @default(0)
  updatedAt  DateTime          @updatedAt

  @@unique([seasonId, tier, userId])
  @@index([seasonId, tier, score(sort: Desc)]) // the bracket query
}

// ── DAILY MISSIONS ───────────────────────────────────────────────────
// Templates are authored once; a daily job deals 3 per user per UTC day
// (rows in MissionProgress). Game events increment `progress` via the
// metric router; `claimedAt` gates the reward exactly once.

model MissionTemplate {
  id          String            @id @default(cuid())
  slug        String            @unique // 'win-3-banker'
  title       String // "Win 3 Banker bets"
  metric      MissionMetric
  target      Int
  rewardChips Int               @default(0)
  rewardGems  Int               @default(0)
  minTier     Int               @default(1) // don't deal Dragon-7 missions to tier-1 rookies
  active      Boolean           @default(true)
  progress    MissionProgress[]
}

enum MissionMetric {
  HANDS_PLAYED
  HANDS_WON
  BANKER_WINS
  PLAYER_WINS
  NATURALS
  SIDE_BET_WINS
  STREAK_REACHED
  CHIPS_WON
  STAGES_CLEARED
  BUDDIES_INVITED
}

model MissionProgress {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId  String
  template    MissionTemplate @relation(fields: [templateId], references: [id])
  day         DateTime        @db.Date // UTC mission day
  progress    Int             @default(0)
  completedAt DateTime? // set the moment progress >= target
  claimedAt   DateTime? // set exactly once by the claim txn

  @@unique([userId, templateId, day]) // idempotent daily deal
  @@index([userId, day])
}
